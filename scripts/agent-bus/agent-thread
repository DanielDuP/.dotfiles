#!/usr/bin/env zsh

set -eu

usage() {
  print -u2 -- 'Usage: agent-thread new <subject>'
  print -u2 -- '       agent-thread show <thread-id>'
  exit 1
}

valid_thread_id() {
  [[ -n "$1" && "$1" != *[^a-zA-Z0-9_.-]* ]]
}

(( $# >= 1 )) || usage
action="$1"
shift
root="${AGENT_BUS_ROOT:-${XDG_STATE_HOME:-$HOME/.local/state}/agent-bus}"

case "$action" in
  new)
    (( $# == 1 )) || usage
    subject="$1"
    [[ -n "${subject// /}" && "$subject" != *[^a-zA-Z0-9_.\ -]* ]] || {
      print -u2 -- 'agent-thread: subject may contain letters, numbers, spaces, dots, hyphens, or underscores'
      exit 1
    }

    creator=$(agent-id) || exit
    subject_slug=$(print -r -- "$subject" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]_-' '-' | sed -E 's/^-+//; s/-+$//')
    [[ -n "$subject_slug" ]] || { print -u2 -- 'agent-thread: subject must contain letters or numbers'; exit 1; }

    mkdir -p "$root/threads"
    temporary=$(mktemp -d "$root/threads/.thread.XXXXXX")
    trap 'rm -rf "$temporary"' EXIT INT TERM
    created_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
    timestamp=$(date -u '+%Y%m%dT%H%M%SZ')
    unique="${temporary:t}"
    unique="${unique#.thread.}"
    thread_id="$timestamp-$subject_slug-$unique"
    mkdir "$temporary/messages"
    {
      print -r -- '---'
      print -r -- 'protocol_version: 2'
      print -r -- "thread_id: $thread_id"
      print -r -- "subject: $subject"
      print -r -- "created_by: $creator"
      print -r -- "created_at: $created_at"
      print -r -- '---'
    } > "$temporary/thread.md"
    mv "$temporary" "$root/threads/$thread_id"
    trap - EXIT INT TERM
    print -r -- "$thread_id"
    ;;
  show)
    (( $# == 1 )) || usage
    thread_id="$1"
    valid_thread_id "$thread_id" || { print -u2 -- "agent-thread: invalid thread ID '$thread_id'"; exit 1; }
    directory="$root/threads/$thread_id"
    [[ -f "$directory/thread.md" ]] || { print -u2 -- "agent-thread: thread not found: $thread_id"; exit 1; }

    command cat -- "$directory/thread.md"
    messages=("$directory/messages"/*.md(N))
    for message in ${(on)messages}; do
      print
      print -r -- "## ${message:t}"
      print
      command cat -- "$message"
    done
    ;;
  *) usage ;;
esac
