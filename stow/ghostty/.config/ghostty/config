# Basic Ghostty configuration
font-family = JetBrainsMono Nerd Font
font-size = 14
theme = dark:Kanagawa Wave,light:modus-operandi
macos-option-as-alt = true
macos-icon = retro

# Window appearance - no title bar, no buttons
window-decoration = none

# Background effects
background-opacity = 1.0

# Mouse behavior
mouse-hide-while-typing = true

# Terminal settings for Neovim and tmux compatibility
term = xterm-256color

# Clipboard settings
clipboard-read = allow
clipboard-write = allow
